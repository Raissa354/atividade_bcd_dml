2. Excluir todos os clientes do estado de SC

// Exclua as vendas dos clientes do estado SC://

DELETE FROM venda
WHERE id_cliente IN (
    SELECT id_cliente
    FROM cliente
    WHERE TRIM(UPPER(estado)) = 'SC'
);


// Depois, exclua os clientes de SC://

DELETE FROM cliente
WHERE TRIM(UPPER(estado)) = 'SC';

-------------------------------------
3. Excluir todos os produtos da marca LG

//Primeiro, exclua as vendas dos produtos LG://
DELETE FROM venda
WHERE id_produto IN (
    SELECT id_produto
    FROM produto
    WHERE marca = 'LG'
);

 //Depois, exclua os produtos LG://
DELETE FROM produto
WHERE marca = 'LG';

---------------------------------------------
4. Excluir os produtos com códigos 3, 5 e 10

//Primeiro, exclua as vendas desses produtos://

DELETE FROM venda
WHERE id_produto IN (3, 5, 10);

//Depois, exclua os produtos://

DELETE FROM produto
WHERE id_produto IN (3, 5, 10);

